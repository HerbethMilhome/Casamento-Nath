{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck.mjs",
            "timeout": 120,
            "statusMessage": "Typechecking (tsc --noEmit)..."
          }
        ]
      }
    ]
  }
}
